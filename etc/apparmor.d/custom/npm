abi <abi/4.0>,

include <tunables/global>

@{exec_path}  = @{HOME}/.nvm/versions/node/*/bin/{npx,npm}
@{exec_path} += @{bin}/{npm,npx}

profile npm
    @{exec_path}
    flags=(attach_disconnected,mediate_deleted) {

  include <abstractions/base-strict>
  include <abstractions/consoles>
  include <abstractions/nameservice-strict>
  include <abstractions/ssl_certs>
  include <abstractions/user-tmp>

  network,

  @{bin}/** ix,
  /proc/** r,

  # nvm
  owner @{HOME}/.nvm/             r,
  owner @{HOME}/.nvm/**           r,
  owner @{HOME}/.nvm/**/bin/*     ix,

  # npm
  owner @{HOME}/.npmrc            rw,
  owner @{HOME}/.npm/{,**}        rwlk,

  # Projects
  owner @{HOME}/Projects/{,**}    rwkmix,
}

