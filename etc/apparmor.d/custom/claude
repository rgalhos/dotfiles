#include <tunables/global>

profile claude
    @{HOME}/.local/share/claude/versions/*
    flags=(attach_disconnected,mediate_deleted) {

  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>
  #include <abstractions/user-tmp>

  network,

  /usr/lib/** mr,
  /usr/bin/** ix,
  /proc/** r,
  /dev/pts/* rw,
  /dev/ptmx rw,
  /dev/tty rw,
  /dev/random r,
  /dev/urandom r,

  # nvm
  owner @{HOME}/.nvm/             r,
  owner @{HOME}/.nvm/**           r,
  owner @{HOME}/.nvm/**/bin/*     ix,

  # npm
  owner @{HOME}/.npm/             rw,
  owner @{HOME}/.npm/**           rwlk,

  # claude
  owner @{HOME}/.claude           rw,
  owner @{HOME}/.claude*          rw,
  owner @{HOME}/.claude/          rklw,
  owner @{HOME}/.claude/**        rklw,

  # Projects
  owner @{HOME}/Projects/   rwkmix,
  owner @{HOME}/Projects/** rwkmix,

  # Minimal traversal of /home
  owner /home/                    r,
  owner @{HOME}/                  r,
}

